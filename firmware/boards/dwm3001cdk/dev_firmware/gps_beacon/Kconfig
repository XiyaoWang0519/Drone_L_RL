menu "UWB beacon options"

choice UWB_ANCHOR_ROLE
    prompt "Anchor role"
    default ROLE_MASTER_ANCHOR
    help
      Select whether this anchor transmits SYNC frames (master) or aligns
      to a master SYNC (slave).

config ROLE_MASTER_ANCHOR
    bool "Master anchor"
    help
      Transmit SYNC frames at the superframe boundary.

config ROLE_SLAVE_ANCHOR
    bool "Slave anchor"
    help
      Listen for SYNC frames and schedule BLINKs using the estimated mapping.

endchoice

config UWB_BEACON_ID
    int "Beacon ID"
    default 1
    range 1 255
    help
      Unique ID encoded in the blink frame.

config UWB_BEACON_SLOT_ID
    int "TDMA slot ID"
    default 0
    range 0 63
    help
      Slot index for this beacon within the superframe.

config UWB_BEACON_FLAGS
    int "Blink flags byte"
    default 0
    range 0 255
    help
      Optional flags inserted into the blink frame.

config UWB_SUPERFRAME_UUS
    int "Superframe duration (UUS)"
    default 20000
    range 1000 200000
    help
      Superframe period in UWB microseconds (approximately microseconds).

config UWB_SLOT_START_UUS
    int "Slot start offset from SYNC (UUS)"
    default 10000
    range 0 50000
    help
      Delay from the SYNC superframe boundary to slot 0.

config UWB_SLOT_UUS
    int "Slot duration (UUS)"
    default 2000
    range 200 20000
    help
      Slot duration in UWB microseconds.

config UWB_TX_GUARD_UUS
    int "Minimum delay before scheduled TX (UUS)"
    default 1000
    range 100 10000
    help
      Minimum time between now and the scheduled TX to avoid a late error.

config UWB_TX_START_DELAY_UUS
    int "Startup delay before first TX (UUS)"
    default 2000
    range 100 20000
    help
      Delay from boot to the first scheduled transmission.

config UWB_TX_TIMEOUT_MS
    int "TX done timeout (ms)"
    default 100
    range 10 1000
    help
      Host timeout waiting for the TX done interrupt.

config UWB_SLAVE_RX_WAIT_MS
    int "Slave RX wait timeout (ms)"
    default 100
    range 10 1000
    help
      Timeout for waiting on SYNC RX while polling the console.

config UWB_SLAVE_IDLE_LOG_PERIOD
    int "Slave idle log period (loops)"
    default 200
    range 1 10000
    help
      Loop count between idle status logs on the slave.

config UWB_ENABLE_BLINK_TX
    bool "Enable slot BLINK transmissions"
    default y
    help
      Keep enabled for localization. Calibration phases suppress BLINKs
      automatically until the network is ready.

config UWB_SLAVE_RX_WINDOWED
    bool "Use predicted SYNC RX windows on the slave"
    default y
    help
      Narrow the SYNC receive window once a clock model is available.

config UWB_SLAVE_RX_EARLY_UUS
    int "Slave RX early margin (UUS)"
    default 3500
    range 100 20000
    help
      Amount of time before the predicted SYNC arrival to open the windowed RX.

config UWB_SLAVE_RX_WINDOW_UUS
    int "Slave RX window size (UUS)"
    default 8000
    range 500 40000
    help
      Total receive window used around the predicted SYNC arrival.

config UWB_SLAVE_RX_WINDOW_PERSIST_MISSES
    int "Consecutive predicted-window misses before full search"
    default 3
    range 1 50
    help
      Number of misses tolerated before the slave falls back to wide-open RX.

config UWB_SLAVE_RX_MIN_ARM_UUS
    int "Minimum advance time for arming delayed RX (UUS)"
    default 400
    range 50 5000
    help
      Minimum lead time needed before delayed receive can be armed safely.

config UWB_SLAVE_RX_WINDOW_IMMEDIATE_FALLBACK
    bool "Allow immediate RX fallback near a predicted SYNC"
    default y
    help
      If the predicted delayed RX arm is too late, fall back to immediate RX
      within the remaining window.

config UWB_CAL_DISCOVERY_ROUNDS
    int "Discovery rounds before calibration"
    default 3
    range 1 16
    help
      Number of broadcast discovery requests sent by the master.

config UWB_CAL_EXPECTED_SLAVES
    int "Expected number of slave anchors"
    default 3
    range 0 15
    help
      If non-zero, the master prefers to see this many slaves before it
      declares the network healthy.

config UWB_CAL_TWR_SAMPLES
    int "DS-TWR samples per master/slave link"
    default 5
    range 1 16
    help
      Number of ranging exchanges used to estimate the one-way master-slave
      propagation delay.

config UWB_CAL_SYNC_SAMPLES
    int "SYNC samples required for clock calibration"
    default 6
    range 2 32
    help
      Number of SYNC receptions a slave gathers before it reports SELF_READY.

config UWB_CAL_GEOMETRY_TARGET_SAMPLES
    int "Target geometry samples per anchor pair"
    default 4
    range 2 16
    help
      Preferred number of successful DS-TWR geometry samples gathered per
      anchor pair before the master stops retrying that edge during boot.

config UWB_CAL_GEOMETRY_SETTLE_MS
    int "Extra geometry retry budget (ms)"
    default 8000
    range 0 10000
    help
      Additional boot-time budget the master may spend retrying geometry
      edges that still have too few successful samples after the initial
      all-pairs sweep.

config UWB_CAL_GEOMETRY_REQUIRE_COMPLETE
    bool "Require full geometry graph before runtime"
    default y
    help
      After the bounded geometry retry window expires, keep focused retries on
      the missing or under-sampled anchor pairs until the boot-time geometry
      graph is complete. Disable this to allow the master to continue with an
      incomplete graph after the retry budget is exhausted.

config UWB_CAL_READY_MIN_TIMEOUT_MS
    int "Minimum self-ready wait timeout (ms)"
    default 4000
    range 500 15000
    help
      Minimum time the master waits in the clock calibration / self-ready
      stage before it degrades or faults the network.

config UWB_CAL_PERSISTENCE
    bool "Persist calibration cache in flash"
    default n
    help
      Cache the most recent calibration blob in internal flash so it can be
      reused after reboot. Disable this during bring-up if flash-backed NVS
      is unstable; wireless discovery, ranging, and localization still work.

config UWB_CAL_WAIT_MS
    int "Calibration wait timeout (ms)"
    default 80
    range 10 1000
    help
      Generic calibration wait timeout used for TWR and report collection.

config UWB_CAL_DISCOVERY_RESP_BASE_UUS
    int "Discovery response base delay (UUS)"
    default 2500
    range 200 20000
    help
      Base delay before a slave replies to a discovery request.

config UWB_CAL_DISCOVERY_RESP_SLOT_UUS
    int "Discovery response slot spacing (UUS)"
    default 4000
    range 200 10000
    help
      Additional delay per slot ID for staggered discovery/status responses.

config UWB_CAL_STATUS_RESP_BASE_UUS
    int "Status response base delay (UUS)"
    default 2500
    range 200 20000
    help
      Base delay before a slave replies to a status request.

config UWB_CAL_STATUS_RESP_SLOT_UUS
    int "Status response slot spacing (UUS)"
    default 4000
    range 200 10000
    help
      Additional delay per slot ID for staggered status responses.

config UWB_CAL_POLL_RX_TO_RESP_TX_DLY_UUS
    int "TWR response delay after poll RX (UUS)"
    default 3200
    range 500 20000
    help
      Delay used by the slave before transmitting a TWR response.

config UWB_CAL_RESP_RX_TO_FINAL_TX_DLY_UUS
    int "TWR final delay after response RX (UUS)"
    default 3200
    range 500 20000
    help
      Delay used by the master before transmitting the TWR final frame.

config UWB_CAL_RX_TIMEOUT_UUS
    int "TWR receive timeout (UUS)"
    default 15000
    range 1000 30000
    help
      Receive timeout used while waiting for TWR and status frames.

config UWB_CAL_NETWORK_BROADCASTS
    int "Number of network state broadcasts"
    default 3
    range 1 10
    help
      Number of times the master repeats the READY/DEGRADED broadcast.

config UWB_CAL_FIXED_TX_BIAS_TICKS
    int "Extra fixed transmit bias correction (DW ticks)"
    default 0
    range -200000 200000
    help
      Additional constant correction applied on top of the measured one-way
      path delay when mapping master time to local TX time.

config UWB_TX_ANT_DLY
    int "DW3000 TX antenna delay"
    default 16385
    range 0 65535
    help
      TX antenna delay written into the DW3000 TX_ANTD register and used when
      stamping delayed-TX timestamps inside DS-TWR frames.

config UWB_RX_ANT_DLY
    int "DW3000 RX antenna delay"
    default 16385
    range 0 65535
    help
      RX antenna delay written into the DW3000 RX antenna-delay register.

endmenu

source "Kconfig.zephyr"
